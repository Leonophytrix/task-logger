# Supabase transaction pooler URL (port 6543); password must be URL encoded.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Direct or session-pooler URL for migrations (port 5432).
DATABASE_MIGRATION_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
APP_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Only set behind a proxy that overwrites this header; otherwise limits are global.
TRUSTED_IP_HEADER=
# Hosted deployments: paste the Supabase CA certificate as a multiline environment
# variable named DATABASE_CA_CERT. Locally, NODE_EXTRA_CA_CERTS is also supported.
DATABASE_CA_CERT=
# Keep connection usage small on serverless hosting.
DB_POOL_MAX=2
